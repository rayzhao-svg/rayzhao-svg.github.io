---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Ray Zhao — A work in progress" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Mathematics, code, and a few other things. The personal notebook of Ray Zhao, studying computer science and mathematics at Yale."
    />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
